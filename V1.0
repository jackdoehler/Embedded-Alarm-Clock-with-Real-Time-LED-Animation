//~~~~~~~~~~~~~~INITIALIZATION~~~~~~~~~~~~~~//

void setup()
{
  Serial.begin(115200);

  URTCLIB_WIRE.begin();
  rtc.set(second, minute, hour, dayOfWeek, day, month, year);

  lcd.begin(LCD_COLS, LCD_ROWS);
  lcd.clear(); 

  matrix.begin();
  matrix_frame = matrix.getPixels();
  matrix.fillScreen(0);
  matrix.show();
 
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);
  pinMode(BTN_EDIT, INPUT_PULLUP);
  pinMode(BTN_INDEX, INPUT_PULLUP);
}

//~~~~~~~~~~~~~~MAIN~~~~~~~~~~~~~~//

void loop()
{
  Serial.print(digitalRead(BTN_EDIT));
  Serial.print(digitalRead(BTN_UP));
  Serial.print(digitalRead(BTN_DOWN));
  Serial.print(digitalRead(BTN_INDEX));
  
  updateClock();

  updateAlarm();

  updateState();

  updateFields();

  updateDisplays();
}
