//~~~~~~~~~~~~~~INCLUDED LIBRARIES~~~~~~~~~~~~~~//

#include <LiquidCrystal.h>
#include <Adafruit_NeoMatrix.h>
#include <Adafruit_NeoPixel.h>
#include "uRTCLib.h"
#include "Wire.h"

//~~~~~~~~~~~~~~STATE VARIABLES~~~~~~~~~~~~~~//

bool    editMode      = false;
uint8_t selectedField = 0;

enum EditTarget    {NO_TARGET, EDIT_CLOCK, EDIT_ALARM}; EditTarget editTarget = NO_TARGET;
enum AxisLock      {NO_LOCK, X_AXIS, Y_AXIS};         AxisLock axisLock     = NO_LOCK;
enum AnimationMode {NO_ANIMATION, RAIN, SUNRISE};     AnimationMode animationMode = SUNRISE;

constexpr uint32_t BLINK_PERIOD   = 500;  // how often the clock blinks in editing mode
constexpr uint32_t BLINK_DURATION = 125;  // how long the clock blinks for in editing mode

bool alarmActive  = false;
bool alarmLatched = false;

//~~~~~~~~~~~~~~LCD SETTINGS~~~~~~~~~~~~~~//

#define rs 3
#define en 4
#define d4 5
#define d5 6
#define d6 7
#define d7 8

#define LCD_COLS 16
#define LCD_ROWS 2

LiquidCrystal lcd(rs, en, d4, d5, d6, d7);

constexpr uint8_t  LCD_REFRESH_RATE     = 25;            // time between frames (ms)
          uint32_t lastLCDFrame        = 0;            // time the last frame was displayed (ms)

//~~~~~~~~~~~~~~MATRIX SETTINGS~~~~~~~~~~~~~~//

#define MATRIX_PIN    2
#define MATRIX_WIDTH  32  // (px)
#define MATRIX_HEIGHT 8   // (px)

Adafruit_NeoMatrix matrix = Adafruit_NeoMatrix(
  MATRIX_WIDTH, MATRIX_HEIGHT, MATRIX_PIN,
  NEO_MATRIX_TOP + NEO_MATRIX_RIGHT +
  NEO_MATRIX_COLUMNS + NEO_MATRIX_ZIGZAG,
  NEO_GRB + NEO_KHZ800
);

uint8_t *matrix_frame;  // holds RGB values for all 256 LEDs
constexpr uint8_t  MATRIX_REFRESH_RATE     = 10;            // time between frames (ms)
          uint32_t lastMatrixFrame        = 0;            // time the last frame was displayed (ms)

constexpr uint8_t  R_MAX            = 13;           // (mA)
constexpr uint8_t  G_MAX            = 11;           // (mA)
constexpr uint8_t  B_MAX            = 12;           // (mA)
constexpr uint8_t  MATRIX_IDLE      = 135;          // (mA)
          float currentDraw      = MATRIX_IDLE;  // estimated current draw of matrix (mA)
constexpr uint16_t MAX_CURRENT_DRAW = 800;         // maximum allowable current (mA)
          uint8_t  brightness       = 255;          // global matrix brightness

uint16_t pixelIndex(uint8_t x, uint8_t y)  // returns the index of the pixel at (x, y) based on zigzag wiring of matrix
{  
  bool evenColumn = (x % 2 == 0);
  uint8_t yMapped;

  if (evenColumn) yMapped = y;
  else yMapped = (MATRIX_HEIGHT - 1) - y;

  return (uint16_t)x * MATRIX_HEIGHT + yMapped;
}

void setLEDxy(uint8_t x, uint8_t y, 
              uint8_t r, uint8_t g, uint8_t b)
{
  if (x >= MATRIX_WIDTH || y >= MATRIX_HEIGHT) return;

  uint8_t *pixel_data = &matrix_frame[pixelIndex(x, y) * 3]; // creates an array of the pixel's colour channels: [G R B]

  pixel_data[1] = r;
  pixel_data[0] = g;
  pixel_data[2] = b;
}

void displayMatrix()
{
  currentDraw = MATRIX_IDLE;

  for (int i = 0; i < MATRIX_WIDTH * MATRIX_HEIGHT; i++)
  {
    uint8_t *pixel_data = &matrix_frame[i * 3];

    currentDraw += (
      ((uint32_t)pixel_data[1] * R_MAX) +
      ((uint32_t)pixel_data[0] * G_MAX) +
      ((uint32_t)pixel_data[2] * B_MAX)
    ) / 255.0;
  }

  if (currentDraw <= MAX_CURRENT_DRAW) brightness = 255;
  else brightness = 255.0f * (float)MAX_CURRENT_DRAW / (float)currentDraw;

  brightness = constrain(brightness, 0, 255);

    Serial.print("Brightness: ");
    Serial.print(brightness);
    Serial.print(" ||| Unscaled Current Draw: ");
    Serial.print(currentDraw);
    Serial.print(" ||| Scaled Current Draw: ");
    Serial.println(currentDraw * brightness / 255.0f);
  
  //matrix.setBrightness(brightness);
  for (int i = 0; i < MATRIX_WIDTH * MATRIX_HEIGHT * 3; i++) matrix_frame[i] = (uint8_t)((float)matrix_frame[i] * brightness / 255.0f);  // reduces brightness for display
  matrix.show();
  for (int i = 0; i < MATRIX_WIDTH * MATRIX_HEIGHT * 3; i++) matrix_frame[i] = (uint8_t)((float)matrix_frame[i] * 255.0f / brightness);  // restores original colours for animation math
}

void clearMatrix()
{
  for (uint8_t x = 0; x < MATRIX_WIDTH; x++)
    for (uint8_t y = 0; y < MATRIX_HEIGHT; y++) setLEDxy(x, y, 0, 0, 0);
}

//~~~~~~~~~~~~~~BUTTON SETTINGS~~~~~~~~~~~~~~//

#define BTN_EDIT  A3
#define BTN_UP    A2
#define BTN_DOWN  A1
#define BTN_INDEX A0

bool upPressed = false;
bool downPressed = false;
bool editPressed = false;
bool indexPressed = false;

bool upHeld = false;
bool downHeld = false;
bool editHeld = false;
uint32_t editPressTime = 0;
uint32_t indexPressTime = 0;
uint32_t upPressTime = 0;
uint32_t downPressTime = 0;
bool fieldEditing = false;

uint32_t holdStart    = 0;  // the time when the button is first actuated
uint32_t lastStepTime = 0;  // the last time the button changed a value of a field

//~~~~~~~~~~~~~~CLOCK~~~~~~~~~~~~~~//

uRTCLib rtc(0x68);

uint8_t hour        = 23;  // the time on the clock
uint8_t minute      = 59;
uint8_t second      = 45;
uint8_t alarmHour   = 0;  // the time the alarm is set to
uint8_t alarmMinute = 0;
uint8_t alarmSecond = 0;

uint8_t year = 26;
uint8_t month = 6;
uint8_t day = 24;
uint8_t dayOfWeek = 4;  // (1=Sunday, 7=Saturday)
uint8_t deviceTemperature;

constexpr uint8_t CLOCK_CHARS = 8;

void updateClock()
{
  if (editTarget != EDIT_CLOCK)
  {
    rtc.refresh();
    hour = rtc.hour();
    minute = rtc.minute();
    second = rtc.second();
  }
}

void updateAlarm()
{
  if (!editMode && !alarmActive && !alarmLatched && hour == alarmHour && minute == alarmMinute && second == alarmSecond)
  {
    alarmActive = true;
    alarmLatched = true;
  }

  if (alarmActive)
  {
    if (!digitalRead(BTN_EDIT) || !digitalRead(BTN_UP) || !digitalRead(BTN_DOWN) || !digitalRead(BTN_INDEX))  // ************************ALARM STOP CONDITION ----- SUBJECT TO CHANGE******************************
    {
      alarmActive = false;
      clearMatrix();
    }
    else if (animationMode == SUNRISE) animateSunrise();
    else if (animationMode == RAIN) animateDrops();
  }

  if (second != alarmSecond || minute != alarmMinute || hour != alarmHour) alarmLatched = false;  // Reset latch once time moves on
}

void incrementField()
{
  if (editTarget == EDIT_CLOCK)
  {
    if      (selectedField == 0) hour   = (hour + 1) % 24;
    else if (selectedField == 1) minute = (minute + 1) % 60;
    else if (selectedField == 2) second = (second + 1) % 60;
  }
  
  else if (editTarget == EDIT_ALARM)
  {
    if      (selectedField == 0) alarmHour   = (alarmHour + 1) % 24;
    else if (selectedField == 1) alarmMinute = (alarmMinute + 1) % 60;
    else if (selectedField == 2) alarmSecond = (alarmSecond + 1) % 60;
  }
}

void decrementField()
{
  if (editTarget == EDIT_CLOCK)
  {
    if      (selectedField == 0) hour   = (hour + 23) % 24;
    else if (selectedField == 1) minute = (minute + 59) % 60;
    else if (selectedField == 2) second = (second + 59) % 60;
  }
  
  else if (editTarget == EDIT_ALARM)
  {
    if      (selectedField == 0) alarmHour   = (alarmHour + 23) % 24;
    else if (selectedField == 1) alarmMinute = (alarmMinute + 59) % 60;
    else if (selectedField == 2) alarmSecond = (alarmSecond + 59) % 60;
  }
}

//~~~~~~~~~~~~~~UI~~~~~~~~~~~~~~//

void printValue(uint8_t n)
{
  if (n < 10) lcd.print("0");  // pads a number with a 0 if needed
  lcd.print(n);
}

void displayRow(uint8_t row, const char* label, uint8_t h, uint8_t m, uint8_t s, bool blinkState)
{
  lcd.setCursor(0, row);

  bool labelBlink = editMode && ((row == 0 && editTarget == EDIT_CLOCK) || (row == 1 && editTarget == EDIT_ALARM)) && !blinkState;

  if (labelBlink) for (uint8_t i = 0; i < strlen(label); i++) lcd.print(" ");  // blank text for when the label is blinking
  else lcd.print(label);

  if (label != 0) for (uint8_t i = 0; i < LCD_COLS - CLOCK_CHARS - strlen(label); i++) lcd.print(" ");  // adds space between the row label and the time
  lcd.setCursor(LCD_COLS - CLOCK_CHARS, row);

  for (uint8_t i = 0; i < 3; i++)
  {
    if (editMode && !blinkState && selectedField == i && ((editTarget == EDIT_CLOCK && row == 0) || (editTarget == EDIT_ALARM && row == 1))) lcd.print("  ");
    else
    {
      if      (i == 0) printValue(h);
      else if (i == 1) printValue(m);
      else if (i == 2) printValue(s);
    }
    
    if (i < 2) lcd.print(":");  // draw colons after hours and minutes
  }
}

void displayTime()
{
  bool blinkState = !(editMode && (millis() % BLINK_PERIOD) >= (BLINK_PERIOD - BLINK_DURATION));
  displayRow(0, "Time", hour, minute, second, blinkState);
  displayRow(1, "ALARM", alarmHour, alarmMinute, alarmSecond, blinkState);
}

void updateState()
{

  ///////////////////EDIT BUTTON////////////////////////

  bool editState = digitalRead(BTN_EDIT);

  if (editState == LOW && !editPressed)  // detects the moment the button is first pressed
  {
    editPressed = true;
    editHeld = false;
    editPressTime = millis();
  }

  if (editPressed && !editHeld && !editMode && millis() - editPressTime >= 1500)   // detects if the button is held down
  {
    editMode = true;
    editTarget = EDIT_CLOCK;
    selectedField = 0;
    axisLock = NO_LOCK;
    editHeld = true;
  }

  if (editState == HIGH && editPressed && millis() - editPressTime >= 100)    // detects the moment the button is first released
  {
    if (!editMode && !editHeld)      // detects if it was a short press outside edit mode
    {
      editMode = true;
      editTarget = EDIT_ALARM;
      selectedField = 0;
      axisLock = NO_LOCK;
    }
    
    else if (editMode && !editHeld)  // detects if it was a short press inside edit mode
    {
      if (editTarget == EDIT_CLOCK) rtc.set(second, minute, hour, dayOfWeek, day, month, year);
      editMode = false;
      fieldEditing = false;
      editTarget = NO_TARGET;
    }

    editPressed = false;
    editHeld = false;
  }




  ///////////////////INDEX BUTTON////////////////////////

  bool indexState = digitalRead(BTN_INDEX);

  if (indexState == LOW && !indexPressed)  // detects the moment the button is first pressed
  {
    indexPressed = true;
    indexPressTime = millis();
  }

  if (indexState == HIGH && indexPressed && millis() - indexPressTime >= 100)    // detects the moment the button is first released
  {
    if (editMode && !fieldEditing)      
    {
      fieldEditing = true;
    }

    else if (editMode && fieldEditing)
    {
      fieldEditing = false;
    }

    indexPressed = false;
  }
}

void updateFields()
{
  bool upState = digitalRead(BTN_UP);
  bool downState = digitalRead(BTN_DOWN);

  if (editMode)
  {
    if (fieldEditing == false)
    {
      if (upState == LOW && downState == HIGH && !upPressed)
      {
        upPressed = true;
        upPressTime = millis();
      }
      
      else if (upState == HIGH && downState == LOW && !downPressed)
      {
        downPressed = true;
        downPressTime = millis();
      }

      if (upState == HIGH && upPressed && millis() - upPressTime >= 100)
      {
        selectedField = (selectedField + 1) % 3;  // select the previous field
        upPressed = false;
      }

      else if (downState == HIGH && downPressed && millis() - downPressTime >= 100)
      {
        selectedField = (selectedField + 2) % 3;  // select the next field
        downPressed = false;
      }
    }

    if (fieldEditing == true)  // if allowed to process y scrolling
    {
      uint32_t holdTime;

      if (upState == LOW && !upPressed && !downPressed)
      {
        upPressed = true;
        upPressTime = millis();
        lastStepTime = 0;
      }
      
      else if (downState == LOW && !upPressed && !downPressed)
      {
        downPressed = true;
        downPressTime = millis();
        lastStepTime = 0;
      }

      if (upPressed) holdTime = millis() - upPressTime;
      else if (downPressed) holdTime = millis() - downPressTime;
 
      if (upState == HIGH && upPressed && millis() - upPressTime >= 100) upPressed = false;
      if (downState == HIGH && downPressed && millis() - downPressTime >= 100) downPressed = false;

      uint32_t delayMs;
      if      (holdTime < 1000)  delayMs = 500;  // accelerates the increment speed based on how long the button has been held for
      else if (holdTime < 2000) delayMs = 250;
      else if (holdTime < 3000) delayMs = 120;
      else                      delayMs = 60;

      if (millis() - lastStepTime >= delayMs)
      {
        if (upPressed && !downPressed) incrementField();
        else if (!upPressed && downPressed) decrementField();
        lastStepTime = millis();
      }
    }
  }
}

void updateDisplays()
{
  if (millis() - lastLCDFrame > LCD_REFRESH_RATE)
  {
    displayTime();
    lastLCDFrame = millis();
  }

  if (millis() - lastMatrixFrame > MATRIX_REFRESH_RATE)
  {
    displayMatrix();
    lastMatrixFrame = millis();
  }
}

//~~~~~~~~~~~~~~RAIN ANIMATION~~~~~~~~~~~~~~//

constexpr uint8_t  MAX_DROPS              = 10;
constexpr uint8_t  DROP_HEIGHT            = 8;            // (px)
constexpr uint8_t  MAX_DROP_SPEED         = 100;          // (px/s)
constexpr uint8_t  MIN_DROP_SPEED         = 50;           // (px/s)
constexpr uint8_t  MIN_SPAWN_DELAY        = 10;           // (ms)
constexpr uint8_t  MAX_SPAWN_DELAY        = 30;           // (ms)
constexpr uint8_t  DROP_BRIGHTNESS_MAX    = 50;
constexpr uint8_t  DROP_BRIGHTNESS_MIN    = DROP_HEIGHT;
          uint32_t lastSpawnTime          = 0;            // (ms)
          uint32_t nextSpawnTime          = 0;            // (ms)

struct Raindrop {
  bool     active;       // whether the drop is still animating
  uint8_t  x;
  int8_t   y;
  uint8_t  v;            // the speed of the drop (px/s)
  uint8_t  brightness;
  uint32_t lastUpdate;   // time when the drop was last updated (ms)
};
Raindrop drops[MAX_DROPS];

void spawnDrop()
{
  for (int i = 0; i < MAX_DROPS; i++)
  {
    if (!drops[i].active)
    {
      drops[i].active      = true;
      drops[i].x           = random(0, MATRIX_WIDTH);
      drops[i].y           = MATRIX_HEIGHT;
      drops[i].v           = random(MIN_DROP_SPEED, MAX_DROP_SPEED + 1);
      drops[i].brightness  = random(DROP_BRIGHTNESS_MIN, DROP_BRIGHTNESS_MAX + 1);
      drops[i].lastUpdate  = millis();
      break;
    }
  }
}

void updateDrops()
{

  for (int i = 0; i < MAX_DROPS; i++)
  {
    if (!drops[i].active) continue;
    
    uint16_t updateInterval = 1000 / drops[i].v;                            // time it takes for drop to move one pixel (ms/px)
    float    fadeFactor     = pow((float)drops[i].brightness, 1.0 / DROP_HEIGHT);  // how much the drop trail fades
    
    if (millis() - drops[i].lastUpdate >= updateInterval)
    {
      drops[i].y -= 1;
      drops[i].lastUpdate = millis();

      if (drops[i].y < -DROP_HEIGHT - 1) 
      {
        drops[i].active = false;
        continue;
      }
      
      if (drops[i].y >= 0 && drops[i].y < MATRIX_HEIGHT) setLEDxy(drops[i].x, drops[i].y, 2, 2, drops[i].brightness);  // light the head of the drop

      for (int y = max(0, drops[i].y + 1); y < min(drops[i].y + DROP_HEIGHT + 2, MATRIX_HEIGHT); y++)                                                      // fade out the trail above the drop
      {
        uint16_t idx = pixelIndex(drops[i].x, y) * 3;
        setLEDxy(drops[i].x, y,
                 matrix_frame[idx + 1] / fadeFactor,
                 matrix_frame[idx + 0] / fadeFactor,
                 matrix_frame[idx + 2] / fadeFactor);
      }
    }
  }
}

void animateDrops()
{
  if (millis() - lastSpawnTime >= nextSpawnTime)
  {
    lastSpawnTime = millis();
    spawnDrop();
    nextSpawnTime = random(MIN_SPAWN_DELAY, MAX_SPAWN_DELAY + 1);
  }

  updateDrops();
}

//~~~~~~~~~~~~~~SUNRISE ANIMATION~~~~~~~~~~~~~~//

constexpr uint8_t SUNRISE_TIME = 10;          // (minutes)
uint32_t sunriseStart = 0;
uint32_t lastSunriseFrame = 0;
constexpr uint16_t KELVIN_MIN = 0;
constexpr uint16_t KELVIN_MAX = 15000;
float startingGradient[MATRIX_HEIGHT] =
    {
      100,   // bottom
      200,
      500,
      1000,
      2000,
      4000,
      8000,
      12000   // top
    };

void kelvinToRGB(uint16_t kelvin, float &r, float &g, float &b)  // from <https://tannerhelland.com/2012/09/18/convert-temperature-rgb-algorithm-code.html>
{
  float temp = kelvin / 100.0;

  if (temp < 1.0)
  {
    r = 0;
    g = 0;
    b = 0;
    return;
  }

  if (temp <= 66) r = 255;  // calculate red
  else
  {
    r = temp - 60;
    //r = 329.6987 * pow(r, -0.1332);  //original
    r = 329.6987 * pow(r, -0.3);
    if (r < 0) r = 0;
    else if (r > 255) r = 255;
  }

  if (temp <= 66)  // calculate green
  {
    g = temp;
    g = 99.4708 * log(g) - 161.1196;
    if (g < 0) g = 0;
    else if (g > 255) g = 255;
  }
  else
  {
    g = temp - 60;
    g = 288.1222 * pow(g, -0.0755);  //original
    //g = 288.1222 * pow(g, -0.10);
    if (g < 0) g = 0;
    else if (g > 255) g = 255;
  }

  if (temp >= 66) b = 255;  // calculate blue
  else
  {
    if (temp <= 19) b = 0;
    else
    {
      // b = temp - 10;
      b = temp - 20;
      b = 138.5177 * log(b) - 305.0448;
      if (b < 0) b = 0;
      else if (b > 255) b = 255;
    }
  }
}

void animateSunrise()
{
  if (alarmLatched) sunriseStart = millis();

  if (millis() - lastSunriseFrame > MATRIX_REFRESH_RATE)
  {
    lastSunriseFrame = millis();
    
    float progress = constrain((float)(millis() - sunriseStart) / (SUNRISE_TIME * 60.0 * 1000.0), 0.0f, 1.0f);

    for (int y = 0; y < MATRIX_HEIGHT; y++)
    {
      float colourGradient = constrain(startingGradient[y] + (KELVIN_MAX - startingGradient[y]) * (pow(progress, 5)), KELVIN_MIN, KELVIN_MAX);

      float r, g, b;
      kelvinToRGB(colourGradient, r, g, b);

      r *= (1.0 - (float)y/(float)MATRIX_HEIGHT) * pow(progress, 2);
      g *= (1.0 - (float)y/(float)MATRIX_HEIGHT) * pow(progress, 2);
      b *= (1.0 - (float)y/(float)MATRIX_HEIGHT) * pow(progress, 2);

      r = constrain(r, 0.0f, 255.0f);
      g = constrain(g, 0.0f, 255.0f);
      b = constrain(b, 0.0f, 255.0f);

      for (uint8_t x = 0; x < MATRIX_WIDTH; x++) setLEDxy(x, y, (uint8_t)r, (uint8_t)g, (uint8_t)b);
    }
  }
}

